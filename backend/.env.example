# Honey Chain Backend Environment Configuration
PROJECT_NAME="Honey Chain Backend"
VERSION="0.1.0"
API_V1_STR="/api/v1"
SECRET_KEY="honey-chain-backend-secret-key-change-in-prod"
ACCESS_TOKEN_EXPIRE_MINUTES=11520 # 8 days

# Database Configuration
# Default to SQLite dev database for instant execution without local Postgres setup required.
# Switch to PostgreSQL URL when Postgres server is running:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/honeychain_db"
DATABASE_URL="sqlite:///./honeychain_dev.db"

CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]
